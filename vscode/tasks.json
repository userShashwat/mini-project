{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Dependencies",
            "type": "shell",
            "command": "pip install -r requirements.txt",
            "group": "none"
        },
        {
            "label": "Download Models",
            "type": "shell",
            "command": "python scripts/download_models.py",
            "group": "none"
        },
        {
            "label": "Start Web Server",
            "type": "shell",
            "command": "python run.py --mode web",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Start GUI",
            "type": "shell",
            "command": "python run.py --mode gui",
            "group": "none"
        }
    ]
}